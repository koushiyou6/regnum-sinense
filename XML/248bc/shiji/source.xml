<!--
  248 BC (秦庄襄王二年) — the Shiji tab of the chronology spreadsheet.
  One <div n="N"> per bracket (one spreadsheet cell), in column order. <head> is the
  column heading; each paragraph of the cell is a <p>. Text is kept as it stands in the spreadsheet.
  Conventions: <term n="ID">, <persName n="ID">, <placeName n="ID">, <title> for a chapter name.
-->
<TEI xmlns="http://www.tei-c.org/ns/1.0">
   <teiHeader>
      <fileDesc>
         <titleStmt>
            <title>Shiji 史记 · 秦庄襄王二年</title>
            <respStmt><resp>Compiled</resp><persName>无骨者伊瓦尔</persName></respStmt>
         </titleStmt>
         <publicationStmt><p/></publicationStmt>
         <sourceDesc>
            <listBibl>
               <bibl xml:id="S"><title>无骨者伊瓦尔《战国历史地图·年表》</title><note xml:lang="eng">Chronology spreadsheet 疆域变化年表 (draft 3, patch 2), Shiji tab; the Shiji text follows the edition used by the compiler.</note></bibl>
            </listBibl>
         </sourceDesc>
      </fileDesc>
   </teiHeader>
   <text>
      <body>

         <div n="1">
            <head>史记（一：本纪）</head>
            <p><title>秦本纪</title>：二年，使<persName n="26">蒙骜</persName>攻<placeName n="9">赵</placeName>，定<placeName n="145">太原</placeName>。</p>
         </div>

         <div n="2">
            <head>史记（二：表）</head>
            <p><placeName n="1">秦</placeName>：<persName n="26">蒙驚</persName>擊<placeName n="9">趙</placeName><placeName n="72">榆次</placeName>、<placeName n="146">新城</placeName>、<placeName n="147">狼孟</placeName>，</p>
            <p>得三十七<term n="12">城</term>。</p>
            <p>日蝕。</p>
            <p><placeName n="11">楚</placeName>：<persName n="47">春申君</persName>徙封於<placeName n="73">吳</placeName>。</p>
         </div>

         <div n="3">
            <head>史记（三：世家）</head>
            <p><title>燕召公世家</title>：七年，<placeName n="1">秦</placeName>拔<placeName n="9">赵</placeName><placeName n="72">榆次</placeName>三十七<term n="12">城</term>，秦置<placeName n="145">大原<term n="38">郡</term></placeName>。</p>
            <p><title>赵世家</title>：十八年，<persName n="127">延陵钧</persName>率师从<term n="46">相国</term><persName n="76">信平君</persName>助<placeName n="10">魏</placeName>攻<placeName n="14">燕</placeName>。秦拔我榆次三十七城。</p>
         </div>

         <div n="4">
            <head>史记（四：列传）</head>
            <p><title>春申君列传</title>：<persName n="63">考烈王</persName>元年，以<persName n="47">黄歇</persName>为<term n="24">相</term>，封为春申君，赐<placeName n="96">淮北</placeName>地十二<term n="10">县</term>。後十五岁，黄歇言之<placeName n="11">楚</placeName>王曰：“淮北地边<placeName n="56">齐</placeName>，其事急，请以为<term n="38">郡</term>便。”因并献淮北十二县。请封於<placeName n="97">江东</placeName>。考烈王许之。春申君因城故<placeName n="73">吴</placeName>墟，以自为都邑。</p>
         </div>

      </body>
   </text>
</TEI>
