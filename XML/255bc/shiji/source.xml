<!--
  255 BC (秦昭襄王五十二年) — the Shiji tab of the chronology spreadsheet.
  One <div n="N"> per bracket (one spreadsheet cell), in column order. <head> is the
  column heading; each paragraph of the cell is a <p>. Text is kept as it stands in the spreadsheet.
  Conventions: <term n="ID">, <persName n="ID">, <placeName n="ID">, <title> for a chapter name.
-->
<TEI xmlns="http://www.tei-c.org/ns/1.0">
   <teiHeader>
      <fileDesc>
         <titleStmt>
            <title>Shiji 史记 · 秦昭襄王五十二年</title>
            <respStmt><resp>Compiled</resp><persName>无骨者伊瓦尔</persName></respStmt>
         </titleStmt>
         <publicationStmt><p/></publicationStmt>
         <sourceDesc>
            <listBibl>
               <bibl xml:id="S"><title>无骨者伊瓦尔《战国历史地图·年表》</title><note xml:lang="eng">Chronology spreadsheet 疆域变化年表 (draft 3, patch 2), Shiji tab; the Shiji text follows the edition used by the compiler.</note></bibl>
            </listBibl>
         </sourceDesc>
      </fileDesc>
   </teiHeader>
   <text>
      <body>

         <div n="1">
            <head>史记（一：本纪）</head>
            <p><title>秦本纪</title>：五十二年，<placeName n="7">周</placeName>民东亡，其器<term n="8">九鼎</term>入<placeName n="1">秦</placeName>。周初亡。</p>
         </div>

         <div n="2">
            <head>史记（二：表）</head>
            <p><placeName n="1">秦</placeName>：取<placeName n="5">西周</placeName>。<persName n="51">王稽</persName><term n="45">棄市</term>。</p>
            <p><placeName n="11">楚</placeName>：取<placeName n="37">魯</placeName>，<persName n="52">魯君</persName>封於<placeName n="47">莒</placeName>。</p>
         </div>

         <div n="3">
            <head>史记（三：世家）</head>
            <p><title>燕召公世家</title>：三年卒，子今王<persName n="53">喜</persName>立。</p>
            <p><title>赵世家</title>：十一年，<term n="12">城</term><placeName n="48">元氏</placeName>，<term n="10">县</term><placeName n="49">上原</placeName>。<persName n="54">武阳君郑安平</persName>死，收其地。</p>
         </div>

      </body>
   </text>
</TEI>
