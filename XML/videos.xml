<?xml version="1.0" encoding="UTF-8"?>
<!-- Videos of Atrium Concordiae and the years of the site they accompany. One <video> per release:
     title, url, and the years covered (from/to as the site's year numbers, BC negative), with an optional note. -->
<videos>
   <!-- <video title="…" url="https://www.youtube.com/watch?v=…" from="-256" to="-249">…</video>
        A video without url is listed in grey; without from/to it lists no years. -->
   <!-- A video with an id gets a page of its own, videos/<id>.html: a contents page in the Catalogue's form,
        <section> entries (approximate periods, no years) and a <years from to> span to be built year by year. -->
   <video id="zhou" title="History of the Zhou Dynasty">
      <section id="shang" label="商" en="Shang">
         <!-- the period's entries, in order: one <bracket> per dated entry, built as videos/zhou/shang/<n>.html -->
         <document dir="videos/zhou/shang" label="History of the Zhou Dynasty">
            <bracket en="c. 1260 BC">约公元前1260年</bracket>
         </document>
      </section>
      <section id="xizhou" label="西周" en="Western Zhou"/>
      <years from="-770" to="-256" en="770–256 BC, by year"/>
   </video>
</videos>
